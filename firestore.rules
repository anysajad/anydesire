rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'TygX6igvhObTbQLSJpTAtmNXkBC3';
    }

    function isDeveloper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isOwner() || isDeveloper();
    }

    function isPublished() {
      return resource != null
        && 'published' in resource.data
        && resource.data.published == true;
    }

    // Developer allow-list. The owner manages it; each developer may read
    // their own document. The owner document (by owner UID) can never be
    // created, updated, or deleted.
    match /admins/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create: if isOwner() && uid != 'TygX6igvhObTbQLSJpTAtmNXkBC3';
      allow update: if isOwner() && uid != 'TygX6igvhObTbQLSJpTAtmNXkBC3';
      allow delete: if isOwner() && uid != 'TygX6igvhObTbQLSJpTAtmNXkBC3';
    }

    match /projects/{projectId} {
      allow read: if isPublished() || isAdmin();

      allow create: if isAdmin()
        // Creator metadata must match the authenticated user
        && request.resource.data.createdByUid == request.auth.uid
        && (request.resource.data.createdByName == null
            || request.resource.data.createdByName is string);

      allow update: if isAdmin()
        // Creator metadata and slug cannot be changed after creation
        && resource.data.createdByUid == request.resource.data.createdByUid
        && resource.data.createdByName == request.resource.data.createdByName
        && resource.data.createdAt == request.resource.data.createdAt
        && resource.data.slug == request.resource.data.slug
        // Publisher metadata: enforce identity on publish transition, preserve otherwise
        && (
          // Transition to published: enforce publisher identity
          (resource.data.published == false && request.resource.data.published == true
           && request.resource.data.publishedByUid == request.auth.uid
           && request.resource.data.publishedAt != null
           // Verify publishedByName matches admins/{uid}.name (or null if no admin doc)
           && ((exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                && (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.name || null)
                   == request.resource.data.publishedByName)
               || (!exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                   && request.resource.data.publishedByName == null)))
          ||
          // All other cases: preserve existing publisher metadata (immutable)
          (resource.data.publishedByUid == request.resource.data.publishedByUid
           && resource.data.publishedByName == request.resource.data.publishedByName
           && resource.data.publishedAt == request.resource.data.publishedAt)
        );

      allow delete: if isAdmin();
    }

    match /settings/contact {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
